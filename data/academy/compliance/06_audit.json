{
    "chapter": 6,
    "slug": "audit",
    "title": "\u5167\u63a7\u8207\u67e5\u6838",
    "description": "\u91cd\u9ede\u67e5\u6838\u4e8b\u9805\u3001\u5e38\u898b\u7f3a\u5931\u8207\u4e09\u9053\u9632\u7dda\u5206\u5de5",
    "objectives": [
        "\u7406\u89e3\u5167\u90e8\u63a7\u5236\u5236\u5ea6\u7684\u6cd5\u5f8b\u4f9d\u64da\u8207\u67b6\u69cb",
        "\u638c\u63e1\u4e3b\u7ba1\u6a5f\u95dc\u91d1\u878d\u6aa2\u67e5\u7684\u91cd\u9ede\u67e5\u6838\u6e05\u55ae",
        "\u8b58\u5225\u8ca1\u7ba1\u696d\u52d9\u6700\u5e38\u88ab\u88c1\u7f70\u7684 Top 10 \u7f3a\u5931",
        "\u719f\u6089\u81ea\u8a55\u3001\u8986\u6838\u8207\u88c1\u7f70\u6551\u6fdf\u4e4b\u6a5f\u5236",
        "\u638c\u63e1\u7406\u5c08\u5341\u8aa1\u8207 KYE \u4fe1\u7528\u67e5\u6838\u3001\u7406\u5c08 21 \u8aa1\u76e3\u63a7\u614b\u6a23"
    ],
    "sections": [
        {
            "heading": "\u5167\u63a7\u6cd5\u5f8b\u4f9d\u64da",
            "html": "<p>\u9280\u884c\u5167\u90e8\u63a7\u5236\u5236\u5ea6\u4f9d\u3008\u91d1\u878d\u63a7\u80a1\u516c\u53f8\u53ca\u9280\u884c\u696d\u5167\u90e8\u63a7\u5236\u53ca\u7a3d\u6838\u5236\u5ea6\u5be6\u65bd\u8fa6\u6cd5\u3009\u5efa\u7acb\uff0c\u5305\u542b\u4e94\u5927\u8981\u7d20\u3002</p><div class=\"mermaid\">graph TD\n    A[\u63a7\u5236\u74b0\u5883<br/>Control Environment] --> B[\u98a8\u96aa\u8a55\u4f30<br/>Risk Assessment]\n    B --> C[\u63a7\u5236\u4f5c\u696d<br/>Control Activities]\n    C --> D[\u8cc7\u8a0a\u8207\u6e9d\u901a<br/>Information & Communication]\n    D --> E[\u76e3\u7763<br/>Monitoring]\n    E --> A\n    style A fill:#019AB3,color:#fff\n    style E fill:#17B5AD,color:#fff</div><table><thead><tr><th>\u8981\u7d20</th><th>\u5be6\u52d9\u5c55\u73fe</th></tr></thead><tbody><tr><td>\u63a7\u5236\u74b0\u5883</td><td>\u8aa0\u4fe1\u6587\u5316\u3001\u8463\u4e8b\u6703\u8207\u9ad8\u968e\u4e3b\u7ba1\u4e4b\u6cbb\u7406\u3001\u7d44\u7e54\u67b6\u69cb</td></tr><tr><td>\u98a8\u96aa\u8a55\u4f30</td><td>\u696d\u52d9\u98a8\u96aa\u8fa8\u8b58\u3001\u8a55\u4f30\u3001\u56de\u61c9\u8207\u76e3\u63a7</td></tr><tr><td>\u63a7\u5236\u4f5c\u696d</td><td>\u6388\u6b0a\u3001\u8077\u52d9\u5206\u5de5\u3001\u8986\u6838\u6a5f\u5236\u3001\u5be6\u9ad4\u63a7\u7ba1</td></tr><tr><td>\u8cc7\u8a0a\u8207\u6e9d\u901a</td><td>\u5167\u5916\u90e8\u8cc7\u8a0a\u8490\u96c6\u8655\u7406\u3001\u5404\u5c64\u7d1a\u6e9d\u901a\u7ba1\u9053</td></tr><tr><td>\u76e3\u7763</td><td>\u6301\u7e8c\u6027\u76e3\u7763\uff08\u696d\u52d9\u55ae\u4f4d\uff09\u3001\u500b\u5225\u8a55\u4f30\uff08\u5167\u7a3d\u55ae\u4f4d\uff09</td></tr></tbody></table><p><strong>\u6cd5\u898f\u4f86\u6e90\uff1a</strong>\u91d1\u878d\u63a7\u80a1\u516c\u53f8\u53ca\u9280\u884c\u696d\u5167\u90e8\u63a7\u5236\u53ca\u7a3d\u6838\u5236\u5ea6\u5be6\u65bd\u8fa6\u6cd5\uff08\u91d1\u7ba1\u6703\uff09</p>"
        },
        {
            "heading": "\u91d1\u6aa2\u67e5\u6838\u91cd\u9ede",
            "html": "<p>\u91d1\u7ba1\u6703\u6aa2\u67e5\u5c40\u5c0d\u9280\u884c\u8ca1\u7ba1\u696d\u52d9\u4e4b\u91d1\u878d\u6aa2\u67e5\uff0c\u91cd\u9ede\u9805\u76ee\u96c6\u4e2d\u65bc\u4e0b\u5217\u516d\u5927\u5340\u584a\u3002\u5167\u7a3d\u81ea\u67e5\u8207\u5916\u90e8\u91d1\u6aa2\u4f7f\u7528\u540c\u4e00\u6aa2\u67e5\u8868\u3002</p><table><thead><tr><th>\u67e5\u6838\u5340\u584a</th><th>\u5177\u9ad4\u9805\u76ee</th></tr></thead><tbody><tr><td>\u5ba2\u6236\u5206\u985e\u8207\u9069\u5408\u5ea6</td><td>\u98a8\u96aa\u5c6c\u6027\u554f\u5377\u3001\u8986\u6838\u983b\u7387\u3001\u903e\u5c6c\u6027\u6838\u51c6\u6bd4\u4f8b</td></tr><tr><td>\u5546\u54c1\u5206\u985e</td><td>\u5546\u54c1\u8a55\u4f30\u66f8\u3001\u65b0\u5546\u54c1\u4e0a\u67b6\u7a0b\u5e8f\u3001\u5546\u54c1\u5206\u7d1a\u4f9d\u64da</td></tr><tr><td>\u92b7\u552e\u904e\u7a0b</td><td>\u5546\u54c1\u8aaa\u660e\u66f8\u4ea4\u4ed8\u3001\u98a8\u96aa\u63ed\u9732\u3001\u9304\u97f3\u9304\u5f71\u5b8c\u6574\u6027</td></tr><tr><td>\u6d17\u9322\u9632\u5236</td><td>CDD \u57f7\u884c\u3001\u53ef\u7591\u4ea4\u6613\u76e3\u63a7\u3001STR \u7533\u5831\u53ca\u6642\u6027</td></tr><tr><td>\u500b\u8cc7\u4fdd\u8b77</td><td>\u8490\u96c6\u544a\u77e5\u66f8\u3001\u654f\u611f\u500b\u8cc7\u8655\u7406\u3001\u5b89\u5168\u7dad\u8b77\u63aa\u65bd</td></tr><tr><td>\u5167\u90e8\u76e3\u7763</td><td>\u81ea\u8a55\u983b\u7387\u3001\u7a3d\u6838\u8a08\u756b\u3001\u7f3a\u5931\u8ffd\u8e64\u8207\u6539\u5584</td></tr></tbody></table>\n<details><summary>\u696d\u52d9\u55ae\u4f4d\u6708\u81ea\u8a55\u6aa2\u6838\u8868\uff08\u5efa\u8b70\uff09</summary><ul><li>\u672c\u6708\u65b0\u958b\u6236\u4e4b KYC \u6587\u4ef6\u662f\u5426\u5b8c\u6574\uff1f</li><li>\u672c\u6708\u92b7\u552e\u662f\u5426\u6709\u903e\u5c6c\u6027\u6848\u4ef6\uff1f\u662f\u5426\u7d93\u4e3b\u7ba1\u6838\u51c6\uff1f</li><li>\u672c\u6708\u53ef\u7591\u4ea4\u6613\u76e3\u63a7\u8b66\u793a\u662f\u5426\u4f9d\u898f\u8655\u7406\uff1f</li><li>\u672c\u6708\u5ba2\u6236\u7533\u8a34\uff0f\u62b1\u6028\u6848\u4ef6\u8655\u7406\u72c0\u6cc1\uff1f</li><li>\u540c\u4ec1\u662f\u5426\u4f9d\u898f\u5b8c\u6210\u672c\u6708\u6559\u80b2\u8a13\u7df4\uff1f</li><li>\u672c\u6708\u500b\u8cc7\u5b58\u53d6\u7d00\u9304\u662f\u5426\u7570\u5e38\uff1f</li></ul></details>"
        },
        {
            "heading": "\u7406\u5c08\u5341\u8aa1\u8207 KYE \u4fe1\u7528\u67e5\u6838",
            "html": "<p>\u70ba\u675c\u7d55\u7406\u8ca1\u5c08\u54e1\u632a\u7528\u5ba2\u6236\u6b3e\u9805\uff0c\u9280\u884c\u516c\u6703\u8a02\u5b9a\u3008\u9280\u884c\u9632\u7bc4\u7406\u8ca1\u5c08\u54e1\u632a\u7528\u5ba2\u6236\u6b3e\u9805\u76f8\u95dc\u5167\u63a7\u4f5c\u696d\u539f\u5247\u3009\uff08\u4fd7\u7a31\u300c\u7406\u5c08\u5341\u8aa1\u300d\uff0c\u5171 13 \u689d\uff1b\u4e2d\u83ef\u6c11\u570b\u9280\u884c\u516c\u6703 108.5.23 \u901a\u904e\u3001\u91d1\u7ba1\u6703 108.6.14 \u91d1\u7ba1\u9280\u5916\u5b57\u7b2c 10801093330 \u865f\u51fd\u5099\u67e5\uff09\u3002\u5176\u4e2d<strong>\u7b2c\u56db\u689d</strong>\u5373\u7406\u5c08\u300c\u4fe1\u7528\u67e5\u6838\u300d\u7684\u6838\u5fc3\u2014\u2014KYE\uff08Know Your Employee\uff0c\u8a8d\u8b58\u54e1\u5de5\uff09\u3002</p><blockquote>\u7b2c\u56db\u689d\uff1a\u9280\u884c\u4efb\u7528\u65b0\u9032\u7406\u8ca1\u5c08\u54e1\uff0c\u61c9\u63a1\u884c\u76e1\u8077\u8abf\u67e5\u7a0b\u5e8f\uff0c\u5efa\u7acb\u9069\u7576\u6a5f\u5236\u77ad\u89e3\u54e1\u5de5<strong>\u54c1\u6027\u7d20\u884c\u3001\u5c08\u696d\u77e5\u8b58\u3001\u4fe1\u7528\u53ca\u8ca1\u52d9\u72c0\u6cc1</strong>\uff0c\u843d\u5be6 KYE \u5236\u5ea6\u4e4b\u57f7\u884c\uff1b\u5c0d\u65bc\u73fe\u8077\u7406\u8ca1\u5c08\u54e1\uff0c\u4ea6\u61c9<strong>\u5b9a\u671f\u6216\u4e0d\u5b9a\u671f\u77ad\u89e3\u5176\u4fe1\u7528\u53ca\u8ca1\u52d9\u72c0\u6cc1</strong>\uff0c\u9810\u9632\u5f0a\u7aef\u4e4b\u767c\u751f\u3002</blockquote><table><thead><tr><th>\u5c0d\u8c61</th><th>\u4fe1\u7528\u67e5\u6838\u505a\u6cd5\uff08\u4f8b\u793a\uff09</th></tr></thead><tbody><tr><td>\u65b0\u9032\u7406\u5c08</td><td>\u554f\u5377\u6aa2\u8996\u7570\u5e38\u5fb5\u5146\uff0f\u67e5\u516c\u958b\u8cc7\u8a0a\u6709\u7121\u72af\u7f6a\u7d00\u9304\u8207\u8ca0\u9762\u65b0\u805e\uff0f\u66f8\u9762\u7570\u5e38\u6642\u9762\u8ac7\u6bd4\u5c0d</td></tr><tr><td>\u73fe\u8077\u7406\u5c08</td><td>\u5b9a\u671f\uff08\u5efa\u8b70\u81f3\u5c11\u6bcf\u5e74\uff09\u91cd\u65b0\u638c\u63e1\u4fe1\u7528\u8207\u8ca1\u52d9\u72c0\u6cc1\uff1b\u5c0d\u8ca1\u52d9\u8b66\u8a0a\uff08\u904e\u5ea6\u8ca0\u50b5\u3001\u5165\u4e0d\u6577\u51fa\uff09\u5206\u7d1a\u8655\u7406</td></tr></tbody></table><p>\u5341\u8aa1\u5176\u9918\u689d\u6587\u91cd\u9ede\uff1a\u7b2c 5 \u689d\u884c\u70ba\u6e96\u5247\uff08\u7981\u4ee3\u5ba2\u4fdd\u7ba1\u5b58\u647a\u5370\u9451\u3001\u7981\u64c5\u81ea\u4ea4\u6613\uff09\u3001\u7b2c 6 \u689d\u4f11\u5047\u8207\u8f2a\u8abf\u3001\u7b2c 7 \u689d\u7981\u4ee3\u5ba2\u5168\u7a0b\u81e8\u6ac3\uff08\u56db\u773c\u539f\u5247\uff09\u3001\u7b2c 8 \u689d\u7db2\u9280\u5bc6\u78bc\u8207\u540c\u88dd\u7f6e\uff0f\u540c IP \u5075\u6e2c\u3001\u7b2c 9 \u689d\u79c1\u4e0b\u8cc7\u91d1\u5f80\u4f86\u76e3\u63a7\u3001\u7b2c 10 \u689d\u7981\u552e\u975e\u6838\u51c6\u5546\u54c1\u3001\u7b2c 11 \u689d\u7981\u81ea\u88fd\u5c0d\u5e33\u55ae\u3001\u7b2c 12 \u689d\u5167\u7a3d\u67e5\u6838\u4e94\u91cd\u9ede\u3002</p>"
        },
        {
            "heading": "\u7406\u5c08 21 \u8aa1\uff1a21 \u9805\u7591\u4f3c\u632a\u7528\u614b\u6a23",
            "html": "<p>2021 \u5e74\u4fee\u6b63\uff08\u91d1\u7ba1\u6703 110.8.24 \u516c\u5e03\u3001<strong>111.1.1 \u65bd\u884c</strong>\uff09\u5f37\u5316\u539f\u5247\u7b2c 9\u300111 \u689d\uff0c\u4e26\u589e\u8a02 21 \u9805\u300c\u7591\u4f3c\u7406\u8ca1\u5c08\u54e1\u632a\u7528\u5ba2\u6236\u6b3e\u9805\u4e4b\u614b\u6a23\u300d\uff0c\u5206\u56db\u7bc7\uff0c\u4f5c\u70ba\u5404\u884c\u9810\u8b66\u76e3\u63a7\u6307\u6a19\uff08\u4fd7\u7a31\u300c\u7406\u5c08 21 \u8aa1 / 2.0\u300d\uff09\u3002\u6ce8\u610f\uff1a\u300c21 \u8aa1\u300d\u975e 21 \u689d\u65b0\u8aa1\u547d\uff0c\u800c\u662f\u589e\u8a02\u7684 21 \u9805\u76e3\u63a7\u614b\u6a23\uff1b\u5341\u8aa1\u672c\u9ad4\u4ecd\u70ba 13 \u689d\u3002</p><table><thead><tr><th>\u7bc7\u5225</th><th>\u9805\u6578</th><th>\u614b\u6a23\u91cd\u9ede</th></tr></thead><tbody><tr><td>\u4ee3\u5ba2\u64cd\u4f5c\u7bc7</td><td>7</td><td>\u81ea\u88fd\u5c0d\u5e33\u55ae\u3001\u884c\u5916\u6536\u4ef6\u3001\u4ee3\u4fdd\u7ba1\u5b58\u647a\u5370\u9451/\u5bc6\u78bc/\u7a7a\u767d\u55ae\u64da\u3001\u4ee3\u5ba2\u5168\u7a0b\u81e8\u6ac3\u3001\u507d\u6539\u6587\u4ef6\u3001\u79c1\u84cb\u7ae0\u6233\u3001\u5099\u8a3b\u8207\u8cc7\u91d1\u53bb\u5411\u4e0d\u7b26</td></tr><tr><td>\u8cc7\u91d1\u5f80\u4f86\u7bc7</td><td>6</td><td>\u8207\u5ba2\u6236\u79c1\u4eba\u501f\u8cb8\u6216\u5e33\u6236\u8cc7\u91d1\u5f80\u4f86\u3001\u8f49\u51fa\u81f3\u975e\u672c\u4eba\u5e33\u6236\u3001\u4e0d\u540c\u5ba2\u6236\u532f\u540c\u4e00\u53d7\u6b3e\u4eba\u3001\u8f49\u5165\u5e33\u865f\u7686\u76f8\u540c\u3001\u8207\u7b2c\u4e09\u4eba\u5e33\u6236\u5f80\u4f86\u9054\u4e00\u5b9a\u91d1\u984d</td></tr><tr><td>\u95dc\u806f\u5e33\u6236\u7bc7</td><td>4</td><td>\u4e0d\u540c\u5ba2\u6236\u7559\u76f8\u540c\u624b\u6a5f/\u5730\u5740/\u96fb\u90f5\u4e14\u8cc7\u7522\u6e1b\u5c11\u3001\u5ba2\u6236\u8207\u7406\u5c08\u7559\u76f8\u540c\u806f\u7d61\u8cc7\u6599\u3001\u672a\u8f2a\u8abf\u5ba2\u6236\u5c0d\u5e33\u55ae\u672a\u9001\u9054\u3001\u5ba2\u6236\u8207\u7406\u5c08\u540c\u4e00 IP \u4ea4\u6613</td></tr><tr><td>\u5176\u4ed6\u884c\u70ba\u7bc7</td><td>4</td><td>\u983b\u7e41\u9ad8\u98a8\u96aa\u6295\u8cc7\u3001<strong>\u5dee\u52e4\u7570\u5e38\u4e14\u4fe1\u7528\u4e0d\u4f73</strong>\u3001\u4e0d\u8b93\u4e3b\u7ba1\u8a8d\u8b58\u5ba2\u6236\u3001<strong>\u5962\u4f88\u54c1\u6d88\u8cbb\u8207\u6536\u5165\u986f\u4e0d\u76f8\u7576</strong></td></tr></tbody></table><p>\u5176\u4e2d\u300c\u5dee\u52e4\u7570\u5e38\u4e14\u4fe1\u7528\u4e0d\u4f73\u300d\u300c\u5962\u4f88\u54c1\u6d88\u8cbb\u8207\u6536\u5165\u4e0d\u76f8\u7576\u300d\u5169\u9805\uff0c\u6b63\u8207\u7b2c 4 \u689d KYE \u4fe1\u7528\uff0f\u8ca1\u52d9\u67e5\u6838\u76f4\u63a5\u547c\u61c9\u2014\u2014KYE \u4e0d\u662f\u9032\u7528\u6642\u505a\u4e00\u6b21\uff0c\u800c\u662f\u8cab\u7a7f\u5728\u8077\u76e3\u63a7\u3002\u5404\u9805\u300c\u4e00\u5b9a\u91d1\u984d\uff0f\u671f\u9593\uff0f\u6bd4\u4f8b\u300d\u9580\u6abb\u7531\u5404\u884c\u4f9d\u98a8\u96aa\u57fa\u790e\u65b9\u6cd5\u81ea\u8a02\u3002</p><p><strong>\u8cc7\u6599\u4f86\u6e90\uff1a</strong>\u9280\u884c\u516c\u6703\u3008\u9280\u884c\u9632\u7bc4\u7406\u8ca1\u5c08\u54e1\u632a\u7528\u5ba2\u6236\u6b3e\u9805\u76f8\u95dc\u5167\u63a7\u4f5c\u696d\u539f\u5247\u3009\uff1b\u9280\u884c\u6cd5\u7b2c 45-1\uff0f129\uff0f61-1 \u689d\uff1b\u91d1\u7ba1\u6703\u6aa2\u67e5\u5c40 110.8.24 \u65b0\u805e\u7a3f\u3002</p>"
        },
        {
            "heading": "\u5e38\u898b\u7f3a\u5931",
            "html": "<p>\u4e0b\u8868\u70ba\u8fd1 3 \u5e74\u91d1\u7ba1\u6703\u516c\u544a\u4e4b\u88c1\u7f70\u6848\u4f8b\u4e2d\uff0c\u8ca1\u7ba1\u696d\u52d9\u6700\u5e38\u88ab\u9ede\u540d\u4e4b\u7f3a\u5931\u3002</p><table><thead><tr><th>\u6392\u540d</th><th>\u7f3a\u5931\u985e\u578b</th><th>\u5178\u578b\u60c5\u5883</th></tr></thead><tbody><tr><td>1</td><td>\u672a\u78ba\u5be6\u57f7\u884c KYC \u8986\u6838</td><td>\u5ba2\u6236\u98a8\u96aa\u5c6c\u6027\u903e\u671f\u672a\u91cd\u8a55</td></tr><tr><td>2</td><td>\u903e\u5c6c\u6027\u92b7\u552e\u6bd4\u4f8b\u904e\u9ad8</td><td>\u4e3b\u7ba1\u6838\u51c6\u6d41\u65bc\u5f62\u5f0f</td></tr><tr><td>3</td><td>\u5546\u54c1\u8aaa\u660e\u66f8\u672a\u4ea4\u4ed8</td><td>\u7121\u4ea4\u4ed8\u8b49\u660e\u3001\u5ba2\u6236\u4e8b\u5f8c\u5426\u8a8d</td></tr><tr><td>4</td><td>\u9304\u97f3\u9304\u5f71\u7f3a\u6f0f</td><td>\u6a94\u6848\u640d\u6bc0\u3001\u6642\u9577\u4e0d\u8db3</td></tr><tr><td>5</td><td>STR \u7533\u5831\u5ef6\u9072</td><td>\u8d85\u904e 10 \u500b\u71df\u696d\u65e5</td></tr><tr><td>6</td><td>PEP \u5ba2\u6236\u672a\u7d93\u9ad8\u968e\u4e3b\u7ba1\u6838\u51c6</td><td>EDD \u7a0b\u5e8f\u672a\u843d\u5be6</td></tr><tr><td>7</td><td>\u5546\u54c1\u8a55\u4f30\u66f8\u672a\u66f4\u65b0</td><td>\u5e02\u5834\u689d\u4ef6\u8b8a\u5316\u4f46\u5546\u54c1\u5206\u7d1a\u672a\u8abf\u6574</td></tr><tr><td>8</td><td>\u500b\u8cc7\u544a\u77e5\u66f8\u7f3a\u6f0f</td><td>\u8490\u96c6\u654f\u611f\u500b\u8cc7\u4f46\u544a\u77e5\u66f8\u672a\u5217\u793a</td></tr><tr><td>9</td><td>\u5167\u90e8\u6559\u80b2\u8a13\u7df4\u7d00\u9304\u7f3a\u5931</td><td>\u672a\u9054\u5e74\u5ea6\u6642\u6578\u8981\u6c42</td></tr><tr><td>10</td><td>\u5ba2\u6236\u7533\u8a34\u672a\u65bc 30 \u65e5\u5167\u56de\u8986</td><td>\u9055\u53cd\u91d1\u4fdd\u6cd5 \u00a713</td></tr></tbody></table>"
        },
        {
            "heading": "\u4e09\u5c64\u67e5\u6838\u6a5f\u5236",
            "html": "<p>\u5167\u63a7\u4e0d\u80fd\u53ea\u9760\u7a3d\u6838\u3002\u4e09\u5c64\u8986\u6838\u6a5f\u5236\u8b93\u554f\u984c\u5728\u6700\u4f4e\u6210\u672c\u7684\u968e\u6bb5\u88ab\u767c\u73fe\u3002</p><div class=\"mermaid\">graph LR\n    A[\u696d\u52d9\u55ae\u4f4d<br/>\u6bcf\u6708\u81ea\u8a55] --> B[\u6cd5\u9075\u55ae\u4f4d<br/>\u6bcf\u5b63\u8986\u6838]\n    B --> C[\u5167\u90e8\u7a3d\u6838<br/>\u6bcf\u5e74\u81f3\u5c11\u4e00\u6b21]\n    C --> D[\u8463\u4e8b\u6703\u7a3d\u6838\u59d4\u54e1\u6703<br/>\u6bcf\u5b63\u5831\u544a]\n    style A fill:#a8dadc\n    style C fill:#019AB3,color:#fff\n    style D fill:#17B5AD,color:#fff</div><table><thead><tr><th>\u5c64\u7d1a</th><th>\u983b\u7387</th><th>\u7522\u51fa</th></tr></thead><tbody><tr><td>\u696d\u52d9\u55ae\u4f4d\u81ea\u8a55</td><td>\u6bcf\u6708</td><td>\u81ea\u8a55\u6aa2\u6838\u8868\u3001\u7f3a\u5931\u8207\u6539\u5584\u8ffd\u8e64</td></tr><tr><td>\u6cd5\u9075\u55ae\u4f4d\u8986\u6838</td><td>\u6bcf\u5b63</td><td>\u8986\u6838\u5831\u544a\u3001\u6559\u80b2\u8a13\u7df4\u8a08\u756b</td></tr><tr><td>\u5167\u90e8\u7a3d\u6838</td><td>\u6bcf\u5e74\u81f3\u5c11\u4e00\u6b21\uff08\u9ad8\u98a8\u96aa\u696d\u52d9\u6bcf\u534a\u5e74\uff09</td><td>\u7a3d\u6838\u5831\u544a\u3001\u7f3a\u5931\u8ffd\u8e64\u3001\u8463\u4e8b\u6703\u5831\u544a</td></tr></tbody></table>\n<details><summary>\u7a3d\u6838\u767c\u73fe\u5f8c\u4e4b\u8655\u7f6e\u6d41\u7a0b</summary><ol><li>\u7a3d\u6838\u5831\u544a\u9001\u696d\u52d9\u55ae\u4f4d\u78ba\u8a8d</li><li>\u696d\u52d9\u55ae\u4f4d\u63d0\u51fa\u6539\u5584\u8a08\u756b\uff08\u6642\u7a0b\u3001\u8cac\u4efb\u4eba\uff09</li><li>\u6cd5\u9075\u55ae\u4f4d\u8986\u6838\u6539\u5584\u8a08\u756b\u5408\u7406\u6027</li><li>\u5167\u7a3d\u8ffd\u8e64\u6539\u5584\u57f7\u884c\u72c0\u6cc1</li><li>\u672a\u6539\u5584\u7f3a\u5931\u9808\u5217\u5165\u4e0b\u6b21\u7a3d\u6838</li><li>\u91cd\u5927\u7f3a\u5931\u61c9\u901a\u5831\u8463\u4e8b\u6703\u7a3d\u6838\u59d4\u54e1\u6703</li></ol></details>"
        },
        {
            "heading": "\u88c1\u7f70\u8207\u6551\u6fdf",
            "html": "<p>\u91d1\u7ba1\u6703\u88c1\u7f70\u7a0b\u5e8f\u4f9d\u884c\u653f\u7a0b\u5e8f\u6cd5\u57f7\u884c\uff0c\u53d7\u8655\u5206\u6a5f\u69cb\u6216\u500b\u4eba\u6709\u6551\u6fdf\u7ba1\u9053\u3002</p><div class=\"mermaid\">graph TD\n    A[\u91d1\u7ba1\u6703\u6aa2\u67e5\u767c\u73fe\u7f3a\u5931] --> B[\u6aa2\u67e5\u5831\u544a\u901a\u77e5\u53d7\u6aa2\u6a5f\u69cb]\n    B --> C{\u6a5f\u69cb\u9673\u8ff0\u610f\u898b}\n    C --> D[\u91d1\u7ba1\u6703\u5be9\u8b70]\n    D --> E[\u88c1\u7f70\u6c7a\u5b9a\u66f8]\n    E --> F{\u53d7\u7f70\u8005\u9078\u64c7}\n    F -->|\u63a5\u53d7| G[\u7e73\u7d0d\u7f70\u9370]\n    F -->|\u4e0d\u670d| H[\u8a34\u9858]\n    H --> I[\u884c\u653f\u8a34\u8a1f]\n    style E fill:#d62828,color:#fff\n    style I fill:#019AB3,color:#fff</div><table><thead><tr><th>\u6551\u6fdf\u65b9\u5f0f</th><th>\u63d0\u8d77\u671f\u9593</th><th>\u5c0d\u8c61</th></tr></thead><tbody><tr><td>\u9673\u8ff0\u610f\u898b</td><td>\u88c1\u7f70\u524d</td><td>\u91d1\u7ba1\u6703</td></tr><tr><td>\u8a34\u9858</td><td>\u8655\u5206\u9001\u9054 30 \u65e5\u5167</td><td>\u884c\u653f\u9662</td></tr><tr><td>\u884c\u653f\u8a34\u8a1f</td><td>\u8a34\u9858\u6c7a\u5b9a\u9001\u9054 2 \u500b\u6708\u5167</td><td>\u9ad8\u7b49\u884c\u653f\u6cd5\u9662</td></tr></tbody></table>\n<details><summary>\u5c0d\u500b\u4eba\u4e4b\u8655\u5206\uff08\u9664\u6a5f\u69cb\u7f70\u9370\u5916\uff09</summary><ul><li>\u9280\u884c\u6cd5 \u00a761-1\uff1a\u5c0d\u5931\u8077\u4eba\u54e1\u4e4b\u89e3\u8077\u3001\u505c\u8077\u3001\u64a4\u63db</li><li>\u91d1\u4fdd\u6cd5 \u00a710\uff1a\u5c0d\u5931\u8077\u4eba\u54e1\u4e4b\u8655\u7f70\u91d1</li><li>\u6d17\u9322\u9632\u5236\u6cd5 \u00a714-17\uff1a\u5c0d\u54e1\u5de5\u84c4\u610f\u914d\u5408\u4e4b\u5211\u4e8b\u8cac\u4efb</li><li>\u696d\u52d9\u4e3b\u7ba1\u4e4b\u9023\u5e36\u8cac\u4efb\uff1a\u82e5\u7763\u5c0e\u4e0d\u5468\uff0c\u4e3b\u7ba1\u4ea6\u53d7\u8655\u5206</li></ul></details><p><strong>\u8cc7\u6599\u4f86\u6e90\uff1a</strong>\u91d1\u878d\u63a7\u80a1\u516c\u53f8\u53ca\u9280\u884c\u696d\u5167\u90e8\u63a7\u5236\u53ca\u7a3d\u6838\u5236\u5ea6\u5be6\u65bd\u8fa6\u6cd5\uff08\u91d1\u7ba1\u6703\uff09\u3001\u91d1\u7ba1\u6703\u88c1\u7f70\u5c08\u5340 <a href=\"https://www.fsc.gov.tw/ch/home.jsp?id=128&parentpath=0\" target=\"_blank\" rel=\"noopener\">fsc.gov.tw \u88c1\u7f70\u5c08\u5340</a></p>"
        }
    ]
